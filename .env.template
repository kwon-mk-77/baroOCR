# ── 데이터베이스 ─────────────────────────────────────────
# 비워두면 로컬 SQLite 파일(backend/data/baroinsu.db)을 사용합니다.
# 운영(Vercel)에서는 반드시 Supabase Postgres 연결 문자열을 넣으세요.
#   Supabase > Project Settings > Database > Connection string (Transaction pooler, 6543 포트 권장)
DATABASE_URL=

# ── 이미지 저장소 (Supabase Storage) ─────────────────────
# 비워두면 로컬 backend/uploads 폴더에 저장합니다.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=receipts

# ── AI 인식 (둘 중 하나만 있어도 됨, Upstage 우선) ─────────
UPSTAGE_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── 카카오 로그인 ───────────────────────────────────────
# developers.kakao.com > 내 애플리케이션 > 앱 키 > REST API 키
KAKAO_REST_API_KEY=
# 카카오 로그인 > 보안 > Client Secret (사용 설정 시)
KAKAO_CLIENT_SECRET=
# 비워두면 접속 주소로 자동 생성: https://<도메인>/api/auth/kakao/callback
# 운영에서는 명시 권장: https://baro-ocr.vercel.app/api/auth/kakao/callback
KAKAO_REDIRECT_URI=
# 로그인 세션 서명용 임의 문자열 (32자 이상 권장)
SESSION_SECRET=
# 로컬 개발 전용: 1 이면 카카오 없이 /api/auth/dev-login 사용 가능 (Vercel에서는 무시)
AUTH_DEV_LOGIN=

# ── 기타 ────────────────────────────────────────────────
# 허용할 프론트엔드 주소 (쉼표 구분). 기본값 *
CORS_ORIGINS=*
