# ── 데이터베이스 ─────────────────────────────────────────
# 비워두면 로컬 SQLite 파일(backend/data/baroinsu.db)을 사용합니다.
# 운영(Vercel)에서는 반드시 Supabase Postgres 연결 문자열을 넣으세요.
#   Supabase > Project Settings > Database > Connection string (Transaction pooler, 6543 포트 권장)
DATABASE_URL=

# ── 이미지 저장소 (Supabase Storage) ─────────────────────
# 비워두면 로컬 backend/uploads 폴더에 저장합니다.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=receipts

# ── AI 인식 (둘 중 하나만 있어도 됨, Upstage 우선) ─────────
UPSTAGE_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── 기타 ────────────────────────────────────────────────
# 허용할 프론트엔드 주소 (쉼표 구분). 기본값 *
CORS_ORIGINS=*
